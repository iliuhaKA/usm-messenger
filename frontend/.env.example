# Вариант A — прямой URL бэкенда (без proxy)
VITE_API_URL=http://localhost:8080/api
# Явный origin для SockJS/STOMP (тот же хост:порт, что и Spring, без /api)
VITE_BACKEND_ORIGIN=http://localhost:8080

# Вариант B — относительные пути + proxy в vite.config (см. /api и /ws)
# VITE_API_URL=/api
# VITE_BACKEND_ORIGIN не нужен — берётся window.location.origin

# Опционально: polling, если нужно отключить — поставь 0
# VITE_MESSAGES_POLL_MS=3500
# VITE_CHATS_POLL_MS=5000

# Устаревшее имя — можно вместо VITE_BACKEND_ORIGIN
# VITE_WS_URL=http://localhost:8080/ws