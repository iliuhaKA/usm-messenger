    {
      "name": "Files",
      "item": [
        {
          "name": "Upload attachment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r && r.id) { pm.collectionVariables.set('attachmentId', String(r.id)); }",
                  "if (r && r.fileId) { pm.collectionVariables.set('fileId', r.fileId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "chatId", "value": "{{chatId}}", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/files/attachments", "host": ["{{baseUrl}}"], "path": ["api", "files", "attachments"] },
            "description": "multipart/form-data. Выбери реальный файл в поле `file` перед отправкой."
          }
        },
        {
          "name": "Upload user avatar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('fileId', pm.response.text()); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/files/avatars/user", "host": ["{{baseUrl}}"], "path": ["api", "files", "avatars", "user"] },
            "description": "Возвращает fileId (raw text). Затем PUT /api/users/me/avatar?fileId=..."
          }
        },
        {
          "name": "Upload chat avatar",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/files/avatars/chat/{{chatId}}", "host": ["{{baseUrl}}"], "path": ["api", "files", "avatars", "chat", "{{chatId}}"] }
          }
        },
        {
          "name": "Download file",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/files/{{fileId}}", "host": ["{{baseUrl}}"], "path": ["api", "files", "{{fileId}}"] },
            "description": "Возвращает бинарный поток. Postman → Send and Download для сохранения."
          }
        },
        {
          "name": "List chat attachments",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/files/chats/{{chatId}}", "host": ["{{baseUrl}}"], "path": ["api", "files", "chats", "{{chatId}}"] }
          }
        },
        {
          "name": "Rename attachment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"new-name.pdf\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/files/{{attachmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "files", "{{attachmentId}}"] }
          }
        },
        {
          "name": "Delete attachment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/files/{{attachmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "files", "{{attachmentId}}"] }
          }
        }
      ]
    },
    {
      "name": "Presence",
      "item": [
        {
          "name": "Get statuses by ids",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/presence?ids=1,2,3,4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "presence"],
              "query": [{ "key": "ids", "value": "1,2,3,4" }]
            },
            "description": "Возвращает Map<userId, ONLINE|OFFLINE>. Источник — Redis (presence:user:*, TTL 60s)."
          }
        }
      ]
    }
  ]
